// BonAgri MVP Database Schema
// HARVEST. TRADE. PROSPER.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SUPPLIER
  AGRO_DEALER
  TRANSPORTER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  OZOW
  PAYFAST
  MANUAL
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum DisputeReason {
  NOT_DELIVERED
  WRONG_ITEM
  DAMAGED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Centralised verification status, shared by the user's safe summary
// (User.businessStatus) and their business applications so the whole app
// speaks one vocabulary. NOT_STARTED only ever appears on User — an
// application always starts at PENDING.
enum VerificationStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  ACTION_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
}

// Recorded against every verification decision (admin or applicant) so past
// administrative choices survive resubmissions.
enum VerificationAction {
  SUBMITTED
  RESUBMITTED
  STARTED_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
  SUSPENDED
}

// Document requirements are configured per role in the verification module;
// the kind list is intentionally small — only evidence a reviewer actually
// needs. Agro-dealers add the agricultural-input licence when their product
// categories require it.
enum VerificationDocumentKind {
  BUSINESS_REGISTRATION
  BUSINESS_LICENCE
  AGRICULTURAL_INPUT_LICENCE
  PROOF_OF_BUSINESS_ADDRESS
  OWNER_ID
  OTHER
}

enum ProductRequestStatus {
  OPEN
  FULFILLED
  WITHDRAWN
}

enum RequestResponseStatus {
  OPEN
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// CP15a: append-only checkpoint ledger event types (evidence — never
// state-machine drivers; CP14's OrderStatus/DeliveryStatus stay authoritative).
enum CheckpointType {
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

// CP15a migration / CP15c behaviour: buyer receipt confirmation lifecycle.
enum ReceiptStatus {
  PENDING
  CONFIRMED
  CONFIRMED_LAZY
  DISPUTED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  // Account settings: the display picture every role can set. The public id
  // is kept alongside so replacing the photo can clean up the old asset.
  avatarUrl       String?
  avatarPublicId  String?
  emailVerifiedAt DateTime?
  // Verification summary — the ONLY verification state public profile reads
  // ever see. Written exclusively by the verification service; buyers get
  // phoneVerifiedAt, suppliers/agro-dealers get businessStatus.
  phoneVerifiedAt     DateTime?
  businessStatus      VerificationStatus @default(NOT_STARTED)
  businessVerifiedAt  DateTime?
  latestApplicationId String?  @unique
  role            UserRole         @default(BUYER)
  status          UserStatus       @default(ACTIVE)
  supplierProfile SupplierProfile?
  addresses       Address[]
  emailVerificationTokens EmailVerificationToken[]
  phoneOtpCodes       PhoneOtpCode[]
  verificationApplications VerificationApplication[] @relation("VerificationApplicant")
  latestApplication   VerificationApplication? @relation("LatestApplication", fields: [latestApplicationId], references: [id], onDelete: SetNull)
  reviewedVerificationApplications VerificationApplication[] @relation("VerificationReviewer")
  verificationActionsTaken VerificationAuditLog[] @relation("VerificationActionAdmin")
  orders          Order[]
  notifications   Notification[]
  actedOnOrders   OrderStatusHistory[]
  openedDisputes  Dispute[] @relation("DisputeOpener")
  resolvedDisputes Dispute[] @relation("DisputeResolver")
  sellerApplication SellerApplication?
  reviewedApplications SellerApplication[] @relation("ApplicationReviewer")
  transporterProfile TransporterProfile?
  productRequests   ProductRequest[]
  cartItems         CartItem[]
  productReviews    ProductReview[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([role])
  @@index([status])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SupplierProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  businessName   String
  description    String?
  registrationNo String?
  phone          String?
  email          String?
  address        String?
  city           String?
  province       String?
  verified       Boolean   @default(false)
  // CP15a: optional farm reference pin for checkpoint geo-plausibility flags.
  lat            Float?
  lng            Float?
  // CP16a: supplier storefront branding (Cloudinary upload or external URL).
  logoUrl        String?
  logoPublicId   String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  responses      RequestResponse[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessName])
  @@index([province])
  @@index([verified])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  province      String?
  postalCode    String?
  country       String   @default("South Africa")
  isDefault     Boolean  @default(false)
  // CP15a: optional delivery reference pin for checkpoint geo-plausibility flags.
  lat           Float?
  lng           Float?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  imagePublicId String?
  products    Product[]
  productRequests ProductRequest[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String          @id @default(uuid())
  supplierId  String
  categoryId  String
  name        String
  slug        String          @unique
  sku         String          @unique
  description String?
  price       Decimal         @db.Decimal(12, 2)
  unit        String
  imageUrl    String?
  // CP16a: Cloudinary public_id of our own asset (derived server-side) so
  // replacements can destroy the old upload; null for external URLs.
  imagePublicId String?
  status      ProductStatus   @default(DRAFT)
  supplier    SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory   Inventory?
  reviews     ProductReview[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  promotionLinks PromoCampaignProduct[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([supplierId])
  @@index([categoryId])
  @@index([status])
  @@index([name])
}

// CP17: buyer ratings — one review per buyer per product. A buyer may only
// review a product after an order containing it reached DELIVERED (checked
// in the service, not by the schema).
model ProductReview {
  id        String   @id @default(uuid())
  productId String
  buyerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([productId, createdAt])
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  lowStockLevel    Int      @default(10)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt        DateTime @updatedAt
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String
  deliveryAddressId String
  orderGroupId      String?
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(12, 2)
  deliveryFee       Decimal     @default(0) @db.Decimal(12, 2)
  total             Decimal     @db.Decimal(12, 2)
  notes             String?
  // Immutable delivery-destination snapshot written at order creation from
  // the validated address (text fields + optional lat/lng pin). Later edits
  // to the saved address never change historical orders; readers materialize
  // deliveryAddress from this when present (null only for pre-snapshot rows
  // that the migration backfills).
  deliverySnapshot  Json?
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryAddress   Address     @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payment           Payment?
  delivery          Delivery?
  invoice           Invoice?
  history           OrderStatusHistory[]
  dispute           Dispute?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderGroupId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  actorRole   UserRole?
  note        String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId])
}

model Dispute {
  id             String        @id @default(uuid())
  orderId        String        @unique
  openedById     String
  reason         DisputeReason
  description    String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy   User   @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy User?  @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([openedById])
}

model SellerApplication {
  id           String                  @id @default(uuid())
  userId       String                  @unique
  desiredRole  UserRole
  businessName String
  message      String?
  status       SellerApplicationStatus @default(PENDING)
  reviewedById String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// Buyer phone verification: 6-digit OTP emailed to the (already verified)
// account address. Only the SHA-256 hash is stored, mirroring
// EmailVerificationToken. Single live code per user — requesting a new one
// invalidates the previous.
model PhoneOtpCode {
  id        String    @id @default(uuid())
  userId    String
  phone     String
  codeHash  String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// One row per submission; resubmissions create a NEW application and keep
// the old one, so administrative history is never erased.
model VerificationApplication {
  id                 String             @id @default(uuid())
  userId             String
  role               UserRole // SUPPLIER | AGRO_DEALER
  status             VerificationStatus @default(PENDING)
  // Business details (spec §2). registrationNumber / contactEmail optional —
  // not every trader is registered.
  businessName       String
  registrationNumber String?
  contactPhone       String
  contactEmail       String?
  physicalAddress    String
  representativeName String
  // Extra role/category-specific answers (e.g. licence categories sold).
  details            Json?
  submittedAt        DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  // Review metadata — set only by admin operations.
  reviewedAt         DateTime?
  reviewedById       String?
  reviewNotes        String? // internal admin notes, never sent to the applicant
  rejectionReason    String? // user-facing, set on REJECTED
  infoRequest        String? // user-facing, set on ACTION_REQUIRED

  user       User   @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  latestOf   User?  @relation("LatestApplication")
  reviewedBy User?  @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  VerificationDocument[]
  auditLogs  VerificationAuditLog[]

  @@index([status, submittedAt])
  @@index([userId])
}

// Private document references only — never bytes, never URLs. The asset
// lives in Cloudinary as type=private and is served exclusively through the
// authorized short-lived signed-URL endpoint.
model VerificationDocument {
  id            String                 @id @default(uuid())
  applicationId String
  kind          VerificationDocumentKind
  publicId      String // bonagri/verification/<uuid>
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime               @default(now())

  application VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Append-only decision trail (spec §4). Written by both applicants
// (SUBMITTED/RESUBMITTED) and admins (everything else).
model VerificationAuditLog {
  id            String             @id @default(uuid())
  applicationId String
  userId        String // subject of the action
  adminId       String // actor (the applicant for their own submissions)
  action        VerificationAction
  fromStatus    VerificationStatus?
  toStatus      VerificationStatus?
  reason        String?
  createdAt     DateTime           @default(now())

  application VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  admin       User                   @relation("VerificationActionAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ProductRequest {
  id              String               @id @default(uuid())
  buyerId         String
  title           String
  categoryId      String?
  quantity        Int
  unit            String
  destinationCity String?
  requiredBy      DateTime?
  notes           String?
  status          ProductRequestStatus @default(OPEN)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  buyer    User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  responses RequestResponse[]

  @@index([status, createdAt])
  @@index([buyerId])
}

model RequestResponse {
  id          String                @id @default(uuid())
  requestId   String
  supplierId  String
  message     String
  quotedPrice Decimal?              @db.Decimal(12, 2)
  quotedUnit  String?
  status      RequestResponseStatus @default(OPEN)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  request  ProductRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([requestId, supplierId])
  @@index([supplierId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String          @id @default(uuid())
  orderId        String          @unique
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amount         Decimal         @db.Decimal(12, 2)
  transactionRef String?
  paidAt         DateTime?
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([transactionRef])
}

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  status         DeliveryStatus @default(PENDING)
  // CP14: null transporterId = self-delivery (CP12 behaviour, unchanged).
  transporterId  String?
  // CP14: stamped when the supplier publishes the job to the claim board.
  publishedAt    DateTime?
  // CP14: audit of the latest failed attempt (kept across re-dispatch).
  failedReason   String?
  failedAt       DateTime?
  trackingNumber String?        @unique
  driverName     String?
  driverPhone    String?
  estimatedDate  DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  notes          String?
  // CP15a: counterparty-confirmation fields (schema now, behaviour in CP15c).
  receiptStatus  ReceiptStatus       @default(PENDING)
  receiptAt      DateTime?
  receiptNote    String?
  handoverAt     DateTime?
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transporter    TransporterProfile? @relation(fields: [transporterId], references: [id], onDelete: SetNull)
  checkpoints    DeliveryCheckpoint[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([transporterId])
}

// CP15a: append-only evidence ledger. Create-only — no update/delete path
// exists anywhere in the service; flags are computed once at insert and
// feed governance (CP15d), never a transition decision.
model DeliveryCheckpoint {
  id          String         @id @default(uuid())
  deliveryId  String
  type        CheckpointType
  // Plain strings (no FK): an audit record must outlive account changes.
  actorUserId String
  actorRole   String
  lat         Float?
  lng         Float?
  accuracyM   Float?
  // Client capture time (skew vs recordedAt is flagged, never rejected).
  clientAt    DateTime
  // Server time — authoritative for speed checks and ordering.
  recordedAt  DateTime       @default(now())
  photoId     String?
  flags       String[]       @default([])
  note        String?
  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  photo       DeliveryPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([deliveryId, recordedAt])
}

// CP15b: photo evidence stored inline (bytea) — volumes are tiny and photos
// back up with the rows they prove. sha256 unique: one photo can never back
// two checkpoints. Served only to the order's counterparties.
model DeliveryPhoto {
  id          String                @id @default(uuid())
  sha256      String                @unique
  mime        String
  bytes       Int
  data        Bytes
  createdAt   DateTime              @default(now())
  checkpoints DeliveryCheckpoint[]
}

model TransporterProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  businessName     String
  vehicleType      String?
  phone            String?
  email            String?
  city             String?
  province         String?
  // CP14: provinces whose published jobs this transporter can see.
  serviceProvinces String[]  @default([])
  verified         Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries       Delivery[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([businessName])
  @@index([province])
  @@index([verified])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  deliveryFee   Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  issuedAt      DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([issuedAt])
}

model NotificationBroadcast {
  id             String   @id @default(uuid())
  title          String
  message        String
  targetRole     String
  recipientCount Int
  sentEmail      Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PromoBanner {
  id            String   @id @default(uuid())
  title         String
  subtitle      String?
  eyebrow       String?
  ctaText       String?  @default("Learn more")
  ctaLink       String   @default("/explore")
  imageUrl      String?
  imagePublicId String?
  tone          String?  @default("from-[#17633a] to-[#0c3f23]")
  targetRole    String?  @default("ALL")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Marketplace promotions: admin-managed campaign cards placed inside the
// product feed. Destinations are stored as plain ids (like checkpoint actors)
// so a campaign row can never be deleted as a side effect of product/shop
// cleanup — the public service drops destinations whose target is no longer
// publicly valid instead.
enum PromoCampaignType {
  FEATURED_PRODUCTS
  NEAR_YOU
  SPECIAL_OFFERS
  DISCOVER_CATEGORIES
  FEATURED_SHOPS
}

enum PromoCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
}

enum PromoCampaignPlacement {
  HOME_TOP
  HOME_MID
  EXPLORE_TOP
  EXPLORE_MID
}

enum PromoCardLayout {
  BANNER
  SPLIT
  COMPACT
  EDITORIAL
  CAROUSEL
}

enum PromoDestinationType {
  PRODUCT
  CATEGORY
  SHOP
  NONE
}

enum PromoEventType {
  IMPRESSION
  CLICK
}

model PromoCampaign {
  id                    String              @id @default(uuid())
  name                  String
  headline              String
  description           String?
  type                  PromoCampaignType
  status                PromoCampaignStatus @default(DRAFT)
  layout                PromoCardLayout     @default(BANNER)
  placement             PromoCampaignPlacement @default(HOME_TOP)
  priority              Int                 @default(0)
  ctaText               String              @default("View offer")
  tone                  String?             @default("from-[#17633a] to-[#0c3f23]")
  isSponsored           Boolean             @default(false)
  startAt               DateTime?
  expiresAt             DateTime?
  destinationType       PromoDestinationType @default(NONE)
  destinationProductId  String?
  destinationCategoryId String?
  destinationSupplierId String?
  impressions           Int                 @default(0)
  clicks                Int                 @default(0)
  images                PromoCampaignImage[]
  products              PromoCampaignProduct[]
  events                PromoCampaignEvent[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, placement, priority])
  @@index([startAt, expiresAt])
}

model PromoCampaignImage {
  id         String        @id @default(uuid())
  campaignId String
  url        String
  publicId   String?
  alt        String?
  sortOrder  Int           @default(0)
  campaign   PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
}

model PromoCampaignProduct {
  id         String        @id @default(uuid())
  campaignId String
  productId  String
  sortOrder  Int           @default(0)
  // Genuine promotional price only; null means "use the product's price".
  promoPrice Decimal?      @db.Decimal(12, 2)
  campaign   PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
}

model PromoCampaignEvent {
  id         String         @id @default(uuid())
  campaignId String
  type       PromoEventType
  // Client-generated idempotency key: one impression per campaign/session,
  // one row per genuine click.
  eventKey   String         @unique
  campaign   PromoCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([campaignId, type, createdAt])
}

